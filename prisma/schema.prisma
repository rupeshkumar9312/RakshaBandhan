// Rakhi Bazaar — data model
// Money is stored in paise (integer) everywhere to avoid float drift.
// Swap provider to "postgresql" + set DATABASE_URL to deploy on Vercel/Neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin | staff
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String
  shortDesc      String?
  // Paise. 24900 = ₹249.00
  price          Int
  compareAtPrice Int?
  sku            String? @unique
  inventory      Int     @default(0)
  // Comma-separated for SQLite portability; exposed as string[] via helpers.
  tags           String  @default("")
  material       String?
  isActive       Boolean @default(true)
  isFeatured     Boolean @default(false)
  sortOrder      Int     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  orders    Order[]
  createdAt DateTime @default(now())
  notes     String?

  @@index([phone])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // RB-2508-0001
  // Order numbers are sequential and guessable, so the confirmation page is
  // addressed by this random token instead — it never exposes one customer's
  // address to someone incrementing a URL.
  publicToken String @unique @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Address snapshot — must survive customer record edits.
  contactName  String
  contactPhone String
  contactEmail String?
  addressLine1 String
  addressLine2 String?
  tower        String?
  flat         String?
  landmark     String?
  city         String  @default("Noida")
  state        String  @default("Uttar Pradesh")
  pincode      String

  items OrderItem[]

  subtotal     Int // paise
  shippingFee  Int @default(0)
  discount     Int @default(0)
  total        Int

  paymentMethod String @default("COD")
  paymentStatus String @default("PENDING") // PENDING | PAID | REFUNDED
  status        String @default("PENDING") // PENDING | PROCESSING | SHIPPED | DELIVERED | CANCELLED

  customerNote String?
  adminNote    String?

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([placedAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Snapshot so historical orders stay accurate if the product changes.
  nameSnapshot  String
  imageSnapshot String?
  unitPrice     Int
  quantity      Int
  lineTotal     Int

  @@index([orderId])
  @@index([productId])
}

model Review {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int // 1..5
  title      String?
  body       String
  isApproved Boolean @default(true)
  createdAt  DateTime @default(now())

  @@index([productId])
}
