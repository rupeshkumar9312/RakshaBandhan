DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Product image uploads use Vercel Blob. Create a Blob store in the Vercel
# dashboard (Storage tab) and copy its token here. On Vercel itself this is
# injected automatically once the store is connected to the project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
NEXT_PUBLIC_SITE_NAME="Rakhi Bazaar"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_PHONE="+91 00000 00000"
NEXT_PUBLIC_SUPPORT_EMAIL="care@example.com"
